# Add this `location` block inside the existing Certbot-managed `server {}`
# block for your domain (the one with `listen 443 ssl;` and the
# `ssl_certificate`/`include .../options-ssl-nginx.conf`/`ssl_dhparam` lines
# Certbot added — leave those untouched). Then: sudo nginx -t && sudo systemctl reload nginx

    location /api/ {
        proxy_pass http://127.0.0.1:8899;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grep jobs can take a while to complete; give the proxy room to poll.
        proxy_read_timeout 120s;
    }
