---
// Naming Ceremony — WhatsApp postcard (Kannada version)
---
<!doctype html>
<html lang="kn">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ಆಮಂತ್ರಣ — ನಾಮಕರಣ ಸಮಾರಂಭ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Kannada:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0d0d0d;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 32px 20px 48px;
            min-height: 100vh;
        }

        .hint {
            font-family: sans-serif;
            font-size: 11px;
            letter-spacing: 0.05em;
            color: #444;
            text-align: center;
            margin-bottom: 16px;
            line-height: 1.7;
        }

        .download-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 28px;
            background: #b8860b;
            color: #fff;
            font-family: sans-serif;
            font-size: 13px;
            letter-spacing: 0.06em;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            margin-bottom: 28px;
            transition: background 0.2s;
        }

        .download-btn:hover { background: #d4a843; }
        .download-btn:disabled { background: #444; cursor: wait; }

        /* ─── THE CARD ─── */
        .card {
            width: 540px;
            background: #fdf6ec;
            border: 2px solid #b8860b;
            position: relative;
            overflow: hidden;
        }

        .card::after {
            content: '';
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(184,134,11,0.25);
            pointer-events: none;
            z-index: 10;
        }

        /* ─── TOP BAND ─── */
        .top-band {
            padding: 26px 48px 22px;
            text-align: center;
            background: linear-gradient(135deg, #3a1f0f 0%, #9e3d2a 50%, #3a1f0f 100%);
        }

        .top-tag {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.78rem;
            font-weight: 500;
            color: rgba(240,208,128,0.95);
            margin-bottom: 8px;
        }

        .kannada-main {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 2.5rem;
            font-weight: 600;
            color: #f0d080;
            line-height: 1.1;
        }

        .gold-rule {
            width: 100px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4a843, transparent);
            margin: 12px auto 4px;
        }

        /* ─── BLESSING BAND ─── */
        .blessing-band {
            background: linear-gradient(180deg, rgba(184,134,11,0.09) 0%, rgba(184,134,11,0.03) 100%);
            border-bottom: 1px solid rgba(184,134,11,0.2);
            padding: 14px 40px 12px;
            text-align: center;
        }

        .invocation {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.78rem;
            font-weight: 700;
            color: #9e6b00;
            line-height: 1.4;
        }

        .inv-sep {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 4px auto;
            width: 120px;
        }

        .inv-sep-line {
            flex: 1;
            height: 1px;
            background: rgba(184,134,11,0.35);
        }

        .inv-sep-gem {
            width: 5px;
            height: 5px;
            background: #b8860b;
            transform: rotate(45deg);
            flex-shrink: 0;
        }

        .elders-line {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.65rem;
            font-weight: 600;
            color: #b8860b;
            margin: 8px 0 4px;
            opacity: 0.85;
        }

        .blessing-text {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.82rem;
            font-weight: 500;
            color: #6b3c2a;
            line-height: 1.7;
        }

        /* ─── MIDDLE ─── */
        .middle {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 18px 32px 16px;
            background: #fdf6ec;
        }

        .radha-img {
            width: 192px;
            height: auto;
            display: block;
            mix-blend-mode: multiply;
            flex-shrink: 0;
        }

        .name-col {
            flex: 1;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .her-name-means {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.88rem;
            font-weight: 500;
            color: #6b3c2a;
        }

        .name-hint {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #9e3d2a;
            line-height: 1.25;
        }

        .orn {
            display: flex;
            align-items: center;
            gap: 7px;
            width: 110px;
        }

        .orn-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4a843);
        }

        .orn-line:last-child {
            background: linear-gradient(90deg, #d4a843, transparent);
        }

        .orn-gem {
            width: 5px;
            height: 5px;
            background: #b8860b;
            transform: rotate(45deg);
            flex-shrink: 0;
        }

        .come-hear {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.82rem;
            font-weight: 500;
            color: #6b3c2a;
            line-height: 1.7;
        }

        /* ─── DATE + VENUE ROW ─── */
        .info-row {
            border-top: 1px solid rgba(184,134,11,0.2);
            border-bottom: 1px solid rgba(184,134,11,0.2);
            display: grid;
            grid-template-columns: 1fr 1px 1fr;
            text-align: center;
            background: rgba(184,134,11,0.03);
        }

        .info-sep { background: rgba(184,134,11,0.2); }

        .info-cell { padding: 16px 14px; }

        .info-label {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.7rem;
            font-weight: 600;
            color: #b8860b;
            margin-bottom: 6px;
        }

        .info-main {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: #3a1f0f;
            line-height: 1.2;
            margin-bottom: 2px;
        }

        .info-sub {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.82rem;
            font-weight: 500;
            color: #6b3c2a;
        }

        /* ─── BOTTOM BAND ─── */
        .bottom-band {
            background: linear-gradient(135deg, #3a1f0f 0%, #9e3d2a 50%, #3a1f0f 100%);
            padding: 18px 48px 22px;
            text-align: center;
        }

        .hosts {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: #f0d080;
            margin-bottom: 5px;
        }

        .timing {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.88rem;
            font-weight: 500;
            color: rgba(240,208,128,0.9);
            margin-bottom: 12px;
        }

        .footer-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            border-top: 1px solid rgba(240,208,128,0.2);
            padding-top: 12px;
        }

        .footer-col { flex: 1; text-align: center; }

        .footer-sep {
            width: 1px;
            height: 36px;
            background: rgba(240,208,128,0.25);
            flex-shrink: 0;
            margin: 0 8px;
        }

        .footer-label {
            font-family: 'Noto Serif Kannada', serif;
            font-size: 0.65rem;
            font-weight: 600;
            color: rgba(240,208,128,0.75);
            margin-bottom: 3px;
        }

        /* URL stays in Latin font */
        .link-url {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.95rem;
            font-weight: 500;
            font-style: italic;
            color: #f0d080;
        }

        .contact-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 600;
            color: #f0d080;
            letter-spacing: 0.04em;
        }
    </style>
</head>
<body>

<p class="hint">
    Download the card below and share on WhatsApp<br/>
    along with the full invite link: <strong style="color:#666;">iamabhilash.in/invite</strong>
</p>
<button class="download-btn" id="dlBtn">⬇ Download Postcard (ಕನ್ನಡ)</button>

<div class="card" id="card">

    <!-- TOP -->
    <div class="top-band">
        <p class="kannada-main">ನಾಮಕರಣ</p>
        <div class="gold-rule"></div>
    </div>

    <!-- BLESSING -->
    <div class="blessing-band">
        <p class="invocation">ಓಂ ನಮೋ ಭಗವತೇ ವಾಸುದೇವಾಯ &nbsp;·&nbsp; ಶ್ರೀ ರಾಘವೇಂದ್ರಾಯ ನಮಃ &nbsp;·&nbsp; ಓಂ ಶ್ರೀ ಭೈರವೇಶ್ವರಾಯ ನಮಃ</p>
        <p class="elders-line">ನಮ್ಮ ಹಿರಿಯರ ಮತ್ತು ತಂದೆ-ತಾಯಿಯ ಆಶೀರ್ವಾದದೊಂದಿಗೆ</p>
        <p class="blessing-text">ಅವರ ಅನುಗ್ರಹದಿಂದ ನಮ್ಮ ಮಗಳು ನಮ್ಮ ಬಳಿಗೆ ಬಂದಿದ್ದಾಳೆ.<br/>ನಿಮ್ಮನ್ನು ಆಮಂತ್ರಿಸಲು ನಾವು ಸಂತೋಷಪಡುತ್ತೇವೆ.</p>
    </div>

    <!-- MIDDLE -->
    <div class="middle">
        <img src="/radha.png" alt="" class="radha-img" />
        <div class="name-col">
            <p class="her-name-means">ಅವಳ ಹೆಸರಿನ ಅರ್ಥ</p>
            <p class="name-hint">ಅಪ್ರತಿಮ</p>
            <div class="orn">
                <div class="orn-line"></div>
                <div class="orn-gem"></div>
                <div class="orn-line"></div>
            </div>
            <p class="come-hear">ಮೊದಲ ಬಾರಿ ಆ ಹೆಸರನ್ನು<br/>ಕೇಳಿ ಬನ್ನಿ</p>
        </div>
    </div>

    <!-- DATE + VENUE -->
    <div class="info-row">
        <div class="info-cell">
            <p class="info-label">ದಿನಾಂಕ ಮತ್ತು ಸಮಯ</p>
            <p class="info-main">ಸೆಪ್ಟೆಂಬರ್ 21</p>
            <p class="info-sub">ಸೋಮವಾರ, 2026 · ಬೆಳಗ್ಗೆ 10:15</p>
        </div>
        <div class="info-sep"></div>
        <div class="info-cell">
            <p class="info-label">ಸ್ಥಳ</p>
            <p class="info-main">ವಿ ಒನ್ ಹೋಟೆಲ್</p>
            <p class="info-sub">ಅಂಬರ ಎಲೀಟ್, ಬೆಂಗಳೂರು</p>
        </div>
    </div>

    <!-- BOTTOM -->
    <div class="bottom-band">
        <p class="hosts">ಅಭಿಲಾಷ್ &amp; ಪ್ರತಿಭಾ</p>
        <p class="timing">ಸಮಾರಂಭ 10:15 AM &nbsp;·&nbsp; ಊಟ 12:00 PM</p>
        <div class="footer-row">
            <div class="footer-col">
                <p class="footer-label">ಪೂರ್ಣ ಆಮಂತ್ರಣ ಮತ್ತು ದಾರಿ</p>
                <p class="link-url">iamabhilash.in/invite</p>
            </div>
            <div class="footer-sep"></div>
            <div class="footer-col">
                <p class="footer-label">ಕರೆ ಮಾಡಿ ಅಥವಾ ವಾಟ್ಸಾಪ್</p>
                <p class="contact-num">+91 63612 51166</p>
            </div>
        </div>
    </div>

</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>
<script is:inline>
    async function imgToDataUrl(src) {
        const res = await fetch(src);
        const blob = await res.blob();
        return new Promise(function(resolve) {
            var reader = new FileReader();
            reader.onloadend = function() { resolve(reader.result); };
            reader.readAsDataURL(blob);
        });
    }

    document.getElementById('dlBtn').addEventListener('click', async function () {
        const btn = document.getElementById('dlBtn');
        btn.disabled = true;
        btn.textContent = 'Generating…';

        try {
            const card = document.getElementById('card');
            const img = card.querySelector('.radha-img');

            const originalSrc = img.src;
            img.src = await imgToDataUrl('/radha.png');
            await new Promise(function(r) { setTimeout(r, 80); });

            const opts = { pixelRatio: 2 };
            await htmlToImage.toPng(card, opts);
            const dataUrl = await htmlToImage.toPng(card, opts);

            img.src = originalSrc;

            const link = document.createElement('a');
            link.download = 'naming-ceremony-invite-kn.png';
            link.href = dataUrl;
            link.click();

            btn.textContent = '⬇ Download Postcard (ಕನ್ನಡ)';
        } catch (err) {
            console.error('Download error:', err);
            btn.textContent = 'Failed — please screenshot the card';
            setTimeout(function() { btn.textContent = '⬇ Download Postcard (ಕನ್ನಡ)'; }, 3000);
        }

        btn.disabled = false;
    });
</script>
</body>
</html>
