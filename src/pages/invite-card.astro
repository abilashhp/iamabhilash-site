---
// Naming Ceremony — WhatsApp postcard (screenshot and share)
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Invite Card — Naming Ceremony</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Cinzel:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0d0d0d;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 32px 20px 48px;
            min-height: 100vh;
        }

        .hint {
            font-family: sans-serif;
            font-size: 11px;
            letter-spacing: 0.05em;
            color: #444;
            text-align: center;
            margin-bottom: 16px;
            line-height: 1.7;
        }

        .download-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 28px;
            background: #b8860b;
            color: #fff;
            font-family: sans-serif;
            font-size: 13px;
            letter-spacing: 0.06em;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            margin-bottom: 28px;
            transition: background 0.2s;
        }

        .download-btn:hover { background: #d4a843; }
        .download-btn:disabled { background: #444; cursor: wait; }

        /* ─── THE CARD ─── */
        .card {
            width: 540px;
            background: #fdf6ec;
            border: 2px solid #b8860b;
            position: relative;
            overflow: hidden;
        }

        /* inner inset border */
        .card::after {
            content: '';
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(184,134,11,0.25);
            pointer-events: none;
            z-index: 10;
        }

        /* ─── TOP BAND (dark — mirrors the invite header) ─── */
        .top-band {
            padding: 22px 48px 18px;
            text-align: center;
            background: linear-gradient(135deg, #3a1f0f 0%, #9e3d2a 50%, #3a1f0f 100%);
            position: relative;
        }

        .top-tag {
            font-family: 'Cinzel', serif;
            font-size: 0.68rem;
            letter-spacing: 0.3em;
            color: rgba(240,208,128,0.95);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .kannada {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.6rem;
            font-weight: 500;
            font-style: italic;
            color: #f0d080;
            line-height: 1;
            letter-spacing: 0.04em;
        }

        .gold-rule {
            width: 100px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4a843, transparent);
            margin: 10px auto 0;
        }

        /* ─── MIDDLE: image + name hint ─── */
        .middle {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 26px 36px 22px;
            background: #fdf6ec;
        }

        /* multiply removes black bg on ivory */
        .radha-img {
            width: 192px;
            height: auto;
            display: block;
            mix-blend-mode: multiply;
            flex-shrink: 0;
        }

        .name-col {
            flex: 1;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .her-name-means {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.9rem;
            font-weight: 500;
            font-style: italic;
            color: #6b3c2a;
            letter-spacing: 0.08em;
        }

        .name-hint {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 700;
            font-style: italic;
            color: #9e3d2a;
            line-height: 1.15;
        }

        .orn {
            display: flex;
            align-items: center;
            gap: 7px;
            width: 110px;
        }

        .orn-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4a843);
        }

        .orn-line:last-child {
            background: linear-gradient(90deg, #d4a843, transparent);
        }

        .orn-gem {
            width: 5px;
            height: 5px;
            background: #b8860b;
            transform: rotate(45deg);
            flex-shrink: 0;
        }

        .come-hear {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.88rem;
            font-weight: 500;
            font-style: italic;
            color: #6b3c2a;
            letter-spacing: 0.04em;
            line-height: 1.65;
        }

        /* ─── DATE + VENUE ROW ─── */
        .info-row {
            border-top: 1px solid rgba(184,134,11,0.2);
            border-bottom: 1px solid rgba(184,134,11,0.2);
            display: grid;
            grid-template-columns: 1fr 1px 1fr;
            text-align: center;
            background: rgba(184,134,11,0.03);
        }

        .info-sep { background: rgba(184,134,11,0.2); }

        .info-cell { padding: 18px 16px; }

        .info-label {
            font-family: 'Cinzel', serif;
            font-size: 0.62rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: #b8860b;
            margin-bottom: 6px;
        }

        .info-main {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: #3a1f0f;
            line-height: 1.1;
            margin-bottom: 2px;
        }

        .info-sub {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.88rem;
            font-weight: 500;
            font-style: italic;
            color: #6b3c2a;
        }

        /* ─── BOTTOM BAND (dark — mirrors the invite footer) ─── */
        .bottom-band {
            background: linear-gradient(135deg, #3a1f0f 0%, #9e3d2a 50%, #3a1f0f 100%);
            padding: 18px 48px 22px;
            text-align: center;
        }

        .hosts {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 700;
            font-style: italic;
            color: #f0d080;
            margin-bottom: 5px;
        }

        .timing {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.92rem;
            font-weight: 500;
            font-style: italic;
            color: rgba(240,208,128,0.9);
            letter-spacing: 0.05em;
            margin-bottom: 12px;
        }

        .link-label {
            font-family: 'Cinzel', serif;
            font-size: 0.62rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(240,208,128,0.75);
            margin-bottom: 3px;
        }

        .footer-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            border-top: 1px solid rgba(240,208,128,0.2);
            padding-top: 12px;
        }

        .footer-col {
            flex: 1;
            text-align: center;
        }

        .footer-sep {
            width: 1px;
            height: 36px;
            background: rgba(240,208,128,0.25);
            flex-shrink: 0;
            margin: 0 8px;
        }

        .link-label, .contact-label {
            font-family: 'Cinzel', serif;
            font-size: 0.55rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(240,208,128,0.7);
            margin-bottom: 3px;
        }

        .link-url {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.95rem;
            font-weight: 500;
            font-style: italic;
            color: #f0d080;
            letter-spacing: 0.02em;
        }

        .contact-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 600;
            color: #f0d080;
            letter-spacing: 0.04em;
        }
    </style>
</head>
<body>

<p class="hint">
    Download the card below and share on WhatsApp<br/>
    along with the full invite link: <strong style="color:#666;">iamabhilash.in/invite</strong>
</p>
<button class="download-btn" id="dlBtn">⬇ Download Postcard</button>

<div class="card" id="card">

    <!-- TOP -->
    <div class="top-band">
        <p class="top-tag">Namakarana &middot; Naming Ceremony</p>
        <p class="kannada">ನಾಮಕರಣ</p>
        <div class="gold-rule"></div>
    </div>

    <!-- MIDDLE -->
    <div class="middle">
        <img src="/radha.png" alt="" class="radha-img" />
        <div class="name-col">
            <p class="her-name-means">her name means</p>
            <p class="name-hint">one of<br/>a kind</p>
            <div class="orn">
                <div class="orn-line"></div>
                <div class="orn-gem"></div>
                <div class="orn-line"></div>
            </div>
            <p class="come-hear">come hear it spoken aloud<br/>for the very first time</p>
        </div>
    </div>

    <!-- DATE + VENUE -->
    <div class="info-row">
        <div class="info-cell">
            <p class="info-label">Date &amp; Time</p>
            <p class="info-main">September 21</p>
            <p class="info-sub">Monday, 2026 · 10:15 AM</p>
        </div>
        <div class="info-sep"></div>
        <div class="info-cell">
            <p class="info-label">Venue</p>
            <p class="info-main">V One Hotel</p>
            <p class="info-sub">Ambara Elite, Bengaluru</p>
        </div>
    </div>

    <!-- BOTTOM -->
    <div class="bottom-band">
        <p class="hosts">Abhilash &amp; Prathibha</p>
        <p class="timing">Ceremony 10:15 AM &nbsp;·&nbsp; Lunch 12:00 PM</p>
        <div class="footer-row">
            <div class="footer-col">
                <p class="link-label">full invite &amp; directions</p>
                <p class="link-url">iamabhilash.in/invite</p>
            </div>
            <div class="footer-sep"></div>
            <div class="footer-col">
                <p class="contact-label">call or whatsapp</p>
                <p class="contact-num">+91 63612 51166</p>
            </div>
        </div>
    </div>

</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>
<script is:inline>
    async function imgToDataUrl(src) {
        const res = await fetch(src);
        const blob = await res.blob();
        return new Promise(function(resolve) {
            var reader = new FileReader();
            reader.onloadend = function() { resolve(reader.result); };
            reader.readAsDataURL(blob);
        });
    }

    document.getElementById('dlBtn').addEventListener('click', async function () {
        const btn = document.getElementById('dlBtn');
        btn.disabled = true;
        btn.textContent = 'Generating…';

        try {
            const card = document.getElementById('card');
            const img = card.querySelector('.radha-img');

            // swap to inline base64 so the renderer has no external fetches
            const originalSrc = img.src;
            img.src = await imgToDataUrl('/radha.png');
            await new Promise(function(r) { setTimeout(r, 80); });

            const opts = { pixelRatio: 2 };
            await htmlToImage.toPng(card, opts);          // first pass — loads fonts
            const dataUrl = await htmlToImage.toPng(card, opts); // second pass — renders them

            img.src = originalSrc; // restore

            const link = document.createElement('a');
            link.download = 'naming-ceremony-invite.png';
            link.href = dataUrl;
            link.click();

            btn.textContent = '⬇ Download Postcard';
        } catch (err) {
            console.error('Download error:', err);
            btn.textContent = 'Failed — please screenshot the card';
            setTimeout(function() { btn.textContent = '⬇ Download Postcard'; }, 3000);
        }

        btn.disabled = false;
    });
</script>
</body>
</html>
