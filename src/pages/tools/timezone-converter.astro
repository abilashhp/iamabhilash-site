---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Timezone Converter — iamabhilash.in" description="Convert times, view live analog clocks, plan cross-timezone meetings, and decode Unix timestamps.">

<nav>
    <a href="/tools" class="nav-back">← Tools</a>
    <a href="/" class="nav-home">iamabhilash.in</a>
</nav>

<div class="page">

    <header class="page-hdr">
        <h1>Timezone Converter</h1>
        <p class="sub">Convert · Live Clocks · Epoch</p>
    </header>

    <div class="tab-bar">
        <button class="tab active" data-tab="convert">Convert</button>
        <button class="tab" data-tab="live">Live Clocks</button>
        <button class="tab" data-tab="epoch">Epoch</button>
    </div>

    <!-- CONVERT -->
    <div id="panel-convert" class="panel">
        <div class="card">
            <div class="form-row">
                <div class="field">
                    <label for="dt-input">Date &amp; Time</label>
                    <input type="datetime-local" id="dt-input" />
                </div>
                <div class="field">
                    <label for="from-tz">From Timezone</label>
                    <select id="from-tz"></select>
                </div>
            </div>
            <button class="btn" id="btn-convert">Convert →</button>
            <div class="err" id="err-convert"></div>
        </div>
        <div class="card results" id="res-convert">
            <p class="res-lbl">Converted Times</p>
            <div class="tz-grid" id="grid-convert"></div>
            <div class="epoch-strip">
                <span class="es-lbl">Unix Epoch</span>
                <span class="es-val" id="ep-convert">—</span>
                <button class="copy-btn" data-copy="ep-convert">Copy</button>
            </div>
        </div>
    </div>

    <!-- LIVE CLOCKS -->
    <div id="panel-live" class="panel">
        <div class="live-grid" id="live-grid"></div>
        <p class="live-note">Updates every second · DST-aware</p>
    </div>

<!-- EPOCH -->
    <div id="panel-epoch" class="panel">
        <div class="card">
            <div class="now-row">
                <span class="now-lbl">Current epoch</span>
                <code id="now-epoch" class="now-val">—</code>
                <button class="copy-btn" data-copy="now-epoch">Copy</button>
            </div>
            <div class="form-row single" style="margin-top:20px">
                <div class="field">
                    <label for="epoch-in">Unix Timestamp (seconds)</label>
                    <input type="number" id="epoch-in" placeholder="e.g. 1748961000" />
                </div>
            </div>
            <button class="btn" id="btn-epoch">Convert →</button>
            <div class="err" id="err-epoch"></div>
        </div>
        <div class="card results" id="res-epoch">
            <p class="res-lbl">Converted Times</p>
            <div class="tz-grid" id="grid-epoch"></div>
        </div>
    </div>

</div>

</Layout>

<style>
nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; height: 52px;
    background: rgba(9,9,11,0.94); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: sticky; top: 0; z-index: 50;
}
.nav-back, .nav-home { font-size: 0.85rem; color: #52525b; transition: color 0.15s; }
.nav-back:hover, .nav-home:hover { color: #e4e4e7; text-decoration: none; }

.page { max-width: 900px; margin: 0 auto; padding: 40px 24px 80px; }
.page-hdr { text-align: center; margin-bottom: 28px; }
h1 {
    font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 6px;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.sub { color: #52525b; font-size: 0.85rem; }

/* TABS */
.tab-bar { display: flex; background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 4px; gap: 2px; margin-bottom: 20px; }
.tab { flex: 1; background: none; border: none; border-radius: 7px; color: #52525b; cursor: pointer; font-size: 0.825rem; font-weight: 600; padding: 9px 6px; transition: all 0.15s; font-family: inherit; }
.tab.active { background: #334155; color: #e4e4e7; }
.tab:hover:not(.active) { color: #a1a1aa; }

/* PANELS */
.panel { display: none; }
.panel.active { display: block; }

/* CARD */
.card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 24px; margin-bottom: 16px; }

/* FORM */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px; }
.form-row.single { grid-template-columns: 1fr; margin-bottom: 18px; }
.field label { display: block; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525b; margin-bottom: 7px; }
input[type="datetime-local"], input[type="date"], input[type="number"], select {
    width: 100%; background: #0f172a; border: 1px solid #334155; border-radius: 8px;
    color: #e2e8f0; font-size: 0.925rem; padding: 10px 12px; outline: none;
    transition: border-color 0.2s; -webkit-appearance: none; font-family: inherit;
}
input:focus, select:focus { border-color: #3b82f6; }
input[type="datetime-local"]::-webkit-calendar-picker-indicator,
input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; opacity: 0.5; }
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; }
input[type="number"] { -moz-appearance: textfield; }

/* BUTTONS */
.btn { width: 100%; background: linear-gradient(135deg, #3b82f6, #6d28d9); border: none; border-radius: 8px; color: #fff; font-size: 0.925rem; font-weight: 600; padding: 12px; cursor: pointer; transition: opacity 0.15s; font-family: inherit; }
.btn:hover { opacity: 0.88; }
.copy-btn { background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #71717a; cursor: pointer; font-size: 0.72rem; font-weight: 600; padding: 4px 10px; transition: all 0.15s; white-space: nowrap; font-family: inherit; }
.copy-btn:hover { background: #1e293b; color: #e4e4e7; }

/* ERROR */
.err { display: none; background: #450a0a; border: 1px solid #7f1d1d; border-radius: 8px; color: #fca5a5; font-size: 0.85rem; padding: 10px 14px; margin-top: 14px; }
.err.show { display: block; }

/* RESULTS */
.results { display: none; }
.results.show { display: block; }
.res-lbl { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525b; margin-bottom: 14px; }

/* TZ GRID */
.tz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 10px; margin-bottom: 14px; }
.tz-card { background: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 14px; cursor: pointer; transition: border-color 0.15s; position: relative; }
.tz-card:hover { border-color: #4f6074; }
.tz-card.source { border-color: #3b82f6; }
.tz-card.source::after { content: 'source'; position: absolute; top: 7px; right: 9px; font-size: 0.58rem; font-weight: 700; text-transform: uppercase; color: #3b82f6; }
.tz-card .c-flag { font-size: 1rem; margin-bottom: 5px; line-height: 1; display: block; }
.tz-card .c-city { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #52525b; margin-bottom: 4px; }
.tz-card .c-time { font-size: 1.35rem; font-weight: 800; color: #f1f5f9; font-variant-numeric: tabular-nums; line-height: 1; }
.tz-card .c-date { font-size: 0.68rem; color: #52525b; margin-top: 4px; }
.tz-card .c-abbr { display: inline-block; background: #1e293b; border-radius: 4px; font-size: 0.62rem; font-weight: 600; color: #71717a; padding: 2px 6px; margin-top: 5px; }

/* EPOCH STRIP */
.epoch-strip { display: flex; align-items: center; gap: 10px; background: #0f172a; border: 1px solid #334155; border-radius: 9px; padding: 11px 14px; }
.es-lbl { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525b; white-space: nowrap; }
.es-val { font-size: 0.95rem; font-weight: 700; color: #a78bfa; font-variant-numeric: tabular-nums; flex: 1; }

/* ── LIVE CLOCKS ── */
.live-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 12px; }
.live-card {
    background: #1e293b; border: 1px solid #334155; border-radius: 14px;
    padding: 22px 16px 18px; display: flex; flex-direction: column; align-items: center; text-align: center;
}
.clock-svg { width: 90px; height: 90px; display: block; margin-bottom: 14px; }
.lc-flag   { font-size: 1.3rem; line-height: 1; margin-bottom: 4px; }
.lc-city   { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #71717a; margin-bottom: 8px; }
.lc-time   { font-size: 1.5rem; font-weight: 800; color: #f1f5f9; font-variant-numeric: tabular-nums; line-height: 1; margin-bottom: 2px; }
.lc-sec    { font-size: 0.9rem; color: #3f3f46; }
.lc-date   { font-size: 0.68rem; color: #52525b; margin-bottom: 10px; }
.lc-meta   { display: flex; align-items: center; justify-content: center; gap: 6px; }
.lc-dot    { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.lc-dot.work   { background: #4ade80; box-shadow: 0 0 5px rgba(74,222,128,0.5); }
.lc-dot.fringe { background: #facc15; }
.lc-dot.off    { background: #3f3f46; }
.lc-abbr   { font-size: 0.65rem; font-weight: 600; color: #71717a; background: #0f172a; padding: 2px 7px; border-radius: 4px; }
.lc-offset { font-size: 0.65rem; color: #3f3f46; }
.live-note { font-size: 0.72rem; color: #3f3f46; text-align: center; }

/* EPOCH PANEL */
.now-row { display: flex; align-items: center; gap: 10px; background: #0f172a; border: 1px solid #334155; border-radius: 9px; padding: 12px 14px; }
.now-lbl { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #52525b; white-space: nowrap; }
.now-val { font-size: 0.95rem; font-weight: 700; color: #a78bfa; font-variant-numeric: tabular-nums; flex: 1; font-family: monospace; }

@media (max-width: 600px) {
    nav { padding: 0 16px; }
    .page { padding: 24px 14px 60px; }
    .form-row { grid-template-columns: 1fr; }
    .tab { font-size: 0.72rem; padding: 8px 3px; }
    .live-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>

<script>
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DAYS   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

const TZ_ALL = {
    'America/Los_Angeles': { label: 'Los Angeles', region: 'PST/PDT', flag: '🇺🇸' },
    'America/Denver':      { label: 'Denver',       region: 'MST/MDT', flag: '🇺🇸' },
    'America/Chicago':     { label: 'Chicago',      region: 'CST/CDT', flag: '🇺🇸' },
    'America/New_York':    { label: 'New York',     region: 'EST/EDT', flag: '🇺🇸' },
    'America/Sao_Paulo':   { label: 'São Paulo',    region: 'BRT',     flag: '🇧🇷' },
    'Etc/UTC':             { label: 'UTC',           region: 'UTC',     flag: '🌐' },
    'Europe/London':       { label: 'London',       region: 'GMT/BST', flag: '🇬🇧' },
    'Europe/Paris':        { label: 'Paris',        region: 'CET',     flag: '🇪🇺' },
    'Europe/Istanbul':     { label: 'Istanbul',     region: 'TRT',     flag: '🇹🇷' },
    'Asia/Dubai':          { label: 'Dubai',        region: 'GST',     flag: '🇦🇪' },
    'Asia/Kolkata':        { label: 'India',        region: 'IST',     flag: '🇮🇳' },
    'Asia/Singapore':      { label: 'Singapore',    region: 'SGT',     flag: '🇸🇬' },
    'Asia/Shanghai':       { label: 'China',        region: 'CST',     flag: '🇨🇳' },
    'Asia/Tokyo':          { label: 'Tokyo',        region: 'JST',     flag: '🇯🇵' },
    'Australia/Sydney':    { label: 'Sydney',       region: 'AEST',    flag: '🇦🇺' },
};

// Fixed zones for live clocks, meeting planner, and convert results
const FIXED_ZONES = ['America/New_York','America/Los_Angeles','Etc/UTC','Asia/Kolkata'];

let currentTab = 'convert';
let liveTimer  = null;
let epochTimer = null;
const pad = n => String(n).padStart(2,'0');

// ── helpers ──────────────────────────────────────────────────────────
function getParts(date, zone) {
    const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: zone, year:'numeric', month:'2-digit', day:'2-digit',
        hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false, weekday:'short',
    }).formatToParts(date);
    const p = Object.fromEntries(parts.map(({type,value}) => [type,value]));
    if (p.hour === '24') p.hour = '00';
    return p;
}
function getAbbr(date, zone) {
    return new Intl.DateTimeFormat('en-US',{timeZone:zone,timeZoneName:'short'})
        .formatToParts(date).find(x=>x.type==='timeZoneName')?.value ?? '';
}
function getOffset(date, zone) {
    const raw = new Intl.DateTimeFormat('en-US',{timeZone:zone,timeZoneName:'longOffset'})
        .formatToParts(date).find(x=>x.type==='timeZoneName')?.value ?? 'GMT+0';
    return raw.replace('GMT+0','UTC').replace('GMT','UTC');
}
function classify(h) {
    const n = parseInt(h);
    if (n >= 9 && n < 18) return 'work';
    if ((n >= 7 && n < 9)||(n >= 18 && n < 20)) return 'fringe';
    return 'off';
}
function dateLabel(p) {
    const d = new Date(Number(p.year), Number(p.month)-1, Number(p.day));
    return `${DAYS[d.getDay()]}, ${MONTHS[Number(p.month)-1]} ${Number(p.day)}`;
}
function localToEpoch(dtStr, zone) {
    const [dp,tp] = dtStr.split('T');
    const [yr,mo,dy] = dp.split('-').map(Number);
    const [hr,mn]    = tp.split(':').map(Number);
    let ms = Date.UTC(yr, mo-1, dy, hr, mn);
    for (let i=0; i<4; i++) {
        const p = getParts(new Date(ms), zone);
        const diff = Date.UTC(yr,mo-1,dy,hr,mn) - Date.UTC(+p.year,+p.month-1,+p.day,+p.hour,+p.minute);
        ms += diff; if (diff===0) break;
    }
    return Math.floor(ms/1000);
}

// ── tabs ─────────────────────────────────────────────────────────────
function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===tab));
    document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active', p.id===`panel-${tab}`));
    stopLive(); stopEpochClock();
    if (tab==='live')  startLive();
    if (tab==='epoch') startEpochClock();
}

// ── convert ──────────────────────────────────────────────────────────
function populateFrom() {
    const sel = document.getElementById('from-tz');
    sel.innerHTML = '';
    for (const [zone,m] of Object.entries(TZ_ALL)) {
        const o = document.createElement('option');
        o.value = zone;
        o.textContent = `${m.flag} ${m.label} (${m.region})`;
        if (zone==='Asia/Kolkata') o.selected = true;
        sel.appendChild(o);
    }
}
function buildTzCard(date, zone, srcZone) {
    const p=getParts(date,zone), abbr=getAbbr(date,zone), m=TZ_ALL[zone];
    const src = zone===srcZone ? ' source':'';
    return `<div class="tz-card${src}" data-val="${p.hour}:${p.minute} ${abbr}">
        <span class="c-flag">${m.flag}</span><span class="c-city">${m.label}</span>
        <div class="c-time">${p.hour}:${p.minute}</div>
        <div class="c-date">${dateLabel(p)}</div>
        <span class="c-abbr">${abbr}</span></div>`;
}
function doConvert() {
    const err=document.getElementById('err-convert'), res=document.getElementById('res-convert');
    err.classList.remove('show');
    const t=document.getElementById('dt-input').value, from=document.getElementById('from-tz').value;
    if (!t){err.textContent='Select a date and time.';err.classList.add('show');return;}
    try {
        const ep=localToEpoch(t,from), date=new Date(ep*1000);
        document.getElementById('grid-convert').innerHTML=FIXED_ZONES.map(z=>buildTzCard(date,z,from)).join('');
        document.getElementById('ep-convert').textContent=String(ep);
        res.classList.add('show');
    } catch { err.textContent='Conversion failed.'; err.classList.add('show'); }
}

// ── live clocks ──────────────────────────────────────────────────────
function buildClockMarks() {
    let s='';
    for (let i=0; i<12; i++) {
        const a=(i/12)*2*Math.PI, major=i%3===0, r1=43, r2=major?36:40;
        s+=`<line x1="${(50+Math.sin(a)*r1).toFixed(1)}" y1="${(50-Math.cos(a)*r1).toFixed(1)}" x2="${(50+Math.sin(a)*r2).toFixed(1)}" y2="${(50-Math.cos(a)*r2).toFixed(1)}" stroke="${major?'#475569':'#1e293b'}" stroke-width="${major?2:1}" stroke-linecap="round"/>`;
    }
    return s;
}
const CLOCK_MARKS = buildClockMarks();

function initLiveClocks() {
    const grid = document.getElementById('live-grid');
    grid.innerHTML = '';
    for (const zone of FIXED_ZONES) {
        const m=TZ_ALL[zone], id=zone.replace(/[/.]/g,'_');
        const card=document.createElement('div');
        card.className='live-card';
        card.innerHTML=`
            <svg viewBox="0 0 100 100" class="clock-svg">
                <circle cx="50" cy="50" r="48" fill="#0f172a" stroke="#1e293b" stroke-width="1.5"/>
                ${CLOCK_MARKS}
                <line id="hh_${id}" x1="50" y1="50" x2="50" y2="30" stroke="#e2e8f0" stroke-width="4"   stroke-linecap="round"/>
                <line id="mh_${id}" x1="50" y1="50" x2="50" y2="18" stroke="#cbd5e1" stroke-width="2.5" stroke-linecap="round"/>
                <line id="sh_${id}" x1="50" y1="58" x2="50" y2="14" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="50" cy="50" r="3"   fill="#0f172a"/>
                <circle cx="50" cy="50" r="1.5" fill="#60a5fa"/>
            </svg>
            <div class="lc-flag">${m.flag}</div>
            <div class="lc-city">${m.label}</div>
            <div class="lc-time"><span id="dt_${id}">--:--</span><span class="lc-sec" id="ds_${id}">:--</span></div>
            <div class="lc-date" id="dd_${id}">—</div>
            <div class="lc-meta">
                <span class="lc-dot off" id="dot_${id}"></span>
                <span class="lc-abbr" id="ab_${id}">—</span>
                <span class="lc-offset" id="of_${id}">—</span>
            </div>`;
        grid.appendChild(card);
    }
}
function setHandTip(id,angle,tip) {
    const el=document.getElementById(id); if(!el)return;
    el.setAttribute('x2',(50+Math.sin(angle)*tip).toFixed(2));
    el.setAttribute('y2',(50-Math.cos(angle)*tip).toFixed(2));
}
function setSecHand(id,angle) {
    const el=document.getElementById(id); if(!el)return;
    const tail=8,tip=36;
    el.setAttribute('x1',(50-Math.sin(angle)*tail).toFixed(2));
    el.setAttribute('y1',(50+Math.cos(angle)*tail).toFixed(2));
    el.setAttribute('x2',(50+Math.sin(angle)*tip).toFixed(2));
    el.setAttribute('y2',(50-Math.cos(angle)*tip).toFixed(2));
}
function updateLiveClocks() {
    const now=new Date();
    for (const zone of FIXED_ZONES) {
        const id=zone.replace(/[/.]/g,'_');
        const p=getParts(now,zone);
        const h=parseInt(p.hour),m=parseInt(p.minute),s=parseInt(p.second);
        setHandTip(`hh_${id}`,((h%12)/12+m/720)*2*Math.PI,22);
        setHandTip(`mh_${id}`,(m/60+s/3600)*2*Math.PI,32);
        setSecHand(`sh_${id}`,(s/60)*2*Math.PI);
        const dtEl=document.getElementById(`dt_${id}`); if(dtEl)dtEl.textContent=`${p.hour}:${p.minute}`;
        const dsEl=document.getElementById(`ds_${id}`); if(dsEl)dsEl.textContent=`:${p.second}`;
        const ddEl=document.getElementById(`dd_${id}`); if(ddEl)ddEl.textContent=dateLabel(p);
        const abEl=document.getElementById(`ab_${id}`); if(abEl)abEl.textContent=getAbbr(now,zone);
        const ofEl=document.getElementById(`of_${id}`); if(ofEl)ofEl.textContent=getOffset(now,zone);
        const dotEl=document.getElementById(`dot_${id}`); if(dotEl)dotEl.className=`lc-dot ${classify(p.hour)}`;
    }
}
function startLive()  { initLiveClocks(); updateLiveClocks(); liveTimer=setInterval(updateLiveClocks,1000); }
function stopLive()   { clearInterval(liveTimer); liveTimer=null; }

// ── copy ─────────────────────────────────────────────────────────────
document.addEventListener('click', e=>{
    const card=e.target.closest('.tz-card');
    if (card?.dataset.val) {
        navigator.clipboard.writeText(card.dataset.val).catch(()=>{});
        const orig=card.style.borderColor;
        card.style.borderColor='#4ade80';
        setTimeout(()=>card.style.borderColor=orig,800);
        return;
    }
    const btn=e.target.closest('[data-copy]');
    if (btn) {
        const val=document.getElementById(btn.dataset.copy)?.textContent??'';
        if (!val||val==='—') return;
        navigator.clipboard.writeText(val).catch(()=>{});
        const orig=btn.textContent; btn.textContent='Copied!';
        setTimeout(()=>btn.textContent=orig,1500);
    }
});

// ── epoch ────────────────────────────────────────────────────────────
function doEpoch() {
    const err=document.getElementById('err-epoch'), res=document.getElementById('res-epoch');
    err.classList.remove('show');
    const val=document.getElementById('epoch-in').value.trim();
    if (!val){err.textContent='Enter a Unix timestamp.';err.classList.add('show');return;}
    try {
        const date=new Date(Number(val)*1000);
        document.getElementById('grid-epoch').innerHTML=FIXED_ZONES.map(z=>buildTzCard(date,z,null)).join('');
        res.classList.add('show');
    } catch { err.textContent='Conversion failed.'; err.classList.add('show'); }
}
function startEpochClock() {
    const el=document.getElementById('now-epoch');
    const tick=()=>{ el.textContent=String(Math.floor(Date.now()/1000)); };
    tick(); epochTimer=setInterval(tick,1000);
}
function stopEpochClock() { clearInterval(epochTimer); epochTimer=null; }

// ── init ─────────────────────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>switchTab(t.dataset.tab)));
document.getElementById('btn-convert').addEventListener('click', doConvert);
document.getElementById('btn-epoch').addEventListener('click', doEpoch);
document.addEventListener('keydown',e=>{
    if (e.key!=='Enter') return;
    if (currentTab==='convert') doConvert();
    if (currentTab==='epoch')   doEpoch();
});

const now=new Date();
document.getElementById('dt-input').value=`${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;

populateFrom();
document.getElementById('panel-convert').classList.add('active');
</script>
