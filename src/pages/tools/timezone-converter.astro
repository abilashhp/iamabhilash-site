---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Timezone Converter — Abhilash HP" description="Convert times across EST, GMT, IST, PST, and BST. Also handles Unix epoch timestamps.">
    <nav>
        <a href="/tools" class="nav-back">← Tools</a>
        <a href="/" class="nav-home">iamabhilash.in</a>
    </nav>

    <div class="container">
        <h1>Timezone Converter</h1>
        <p class="subtitle">Convert between EST, GMT, IST, PST, and BST — or use epoch time</p>

        <div class="tabs">
            <button class="tab active" onclick="switchTab('datetime')">Date &amp; Time</button>
            <button class="tab" onclick="switchTab('epoch')">Epoch Timestamp</button>
        </div>

        <!-- Date & Time panel -->
        <div id="panel-datetime" class="panel active">
            <div class="card">
                <div class="form-row">
                    <div>
                        <label for="datetime-input">Date &amp; Time</label>
                        <input type="datetime-local" id="datetime-input" />
                    </div>
                    <div>
                        <label for="source-tz">From Timezone</label>
                        <select id="source-tz">
                            <option value="EST">EST — Eastern Time</option>
                            <option value="GMT">GMT — Greenwich Mean Time</option>
                            <option value="IST">IST — India Standard Time</option>
                            <option value="PST">PST — Pacific Time</option>
                            <option value="BST">BST — British Time (London)</option>
                        </select>
                    </div>
                </div>
                <button class="btn" id="convert-dt-btn" onclick="convertDatetime()">Convert</button>
                <div class="error" id="error-dt"></div>
            </div>

            <div class="card results" id="results-dt">
                <div class="results-title">Converted Times</div>
                <div class="tz-grid" id="grid-dt"></div>
                <div class="epoch-strip">
                    <span class="epoch-strip-label">Epoch (Unix)</span>
                    <span class="epoch-strip-value" id="epoch-from-dt">—</span>
                    <button class="copy-btn" onclick="copyEpoch('epoch-from-dt')">Copy</button>
                </div>
            </div>
        </div>

        <!-- Epoch panel -->
        <div id="panel-epoch" class="panel">
            <div class="card">
                <div class="form-row single">
                    <div>
                        <label for="epoch-input">Unix Timestamp (seconds)</label>
                        <input type="number" id="epoch-input" placeholder="e.g. 1748961000" />
                    </div>
                </div>
                <button class="btn" id="convert-ep-btn" onclick="convertEpoch()">Convert</button>
                <div class="error" id="error-ep"></div>
            </div>

            <div class="card results" id="results-ep">
                <div class="results-title">Converted Times</div>
                <div class="tz-grid" id="grid-ep"></div>
            </div>
        </div>
    </div>
</Layout>

<style>
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 40px;
        border-bottom: 1px solid #334155;
        position: sticky;
        top: 0;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(8px);
        z-index: 10;
    }

    .nav-back, .nav-home {
        color: #64748b;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

    .nav-back:hover, .nav-home:hover {
        color: #e2e8f0;
        text-decoration: none;
    }

    .container {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    h1 {
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 8px;
        background: linear-gradient(135deg, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .subtitle {
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 28px;
    }

    .tabs {
        display: flex;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 4px;
        margin-bottom: 20px;
    }

    .tab {
        flex: 1;
        background: none;
        border: none;
        border-radius: 7px;
        color: #64748b;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 10px;
        transition: background 0.15s, color 0.15s;
    }

    .tab.active { background: #334155; color: #e2e8f0; }

    .card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 28px;
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
    }

    input[type="datetime-local"],
    input[type="number"],
    select {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #e2e8f0;
        font-size: 1rem;
        padding: 12px 14px;
        outline: none;
        transition: border-color 0.2s;
        -webkit-appearance: none;
    }

    input[type="datetime-local"]:focus,
    input[type="number"]:focus,
    select:focus { border-color: #60a5fa; }

    input[type="datetime-local"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; }
    input[type="number"] { -moz-appearance: textfield; }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .form-row.single { grid-template-columns: 1fr; }

    @media (max-width: 520px) { .form-row { grid-template-columns: 1fr; } }

    .btn {
        width: 100%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        padding: 14px;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
    }

    .btn:hover { opacity: 0.9; }
    .btn:active { transform: scale(0.99); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .panel { display: none; }
    .panel.active { display: block; }

    .results { display: none; }
    .results.visible { display: block; }

    .results-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 14px;
    }

    .tz-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .tz-card {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 14px;
        position: relative;
        transition: border-color 0.2s;
    }

    .tz-card.source { border-color: #3b82f6; }

    .tz-card.source::after {
        content: 'input';
        position: absolute;
        top: 7px; right: 9px;
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #3b82f6;
    }

    .tz-label { font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 5px; }
    .tz-time { font-size: 1.25rem; font-weight: 700; color: #f1f5f9; font-variant-numeric: tabular-nums; }
    .tz-date { font-size: 0.7rem; color: #64748b; margin-top: 3px; }
    .tz-abbr { display: inline-block; background: #1e293b; border-radius: 4px; font-size: 0.68rem; font-weight: 600; color: #94a3b8; padding: 2px 6px; margin-top: 5px; }

    .epoch-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 12px 16px;
        gap: 12px;
    }

    .epoch-strip-label { font-size: 0.75rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
    .epoch-strip-value { font-size: 1rem; font-weight: 700; color: #a78bfa; font-variant-numeric: tabular-nums; word-break: break-all; }

    .copy-btn {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 6px;
        color: #94a3b8;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 5px 10px;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
    }

    .copy-btn:hover { background: #334155; color: #e2e8f0; }

    .error {
        background: #450a0a;
        border: 1px solid #dc2626;
        border-radius: 8px;
        color: #fca5a5;
        font-size: 0.875rem;
        padding: 12px 16px;
        display: none;
        margin-top: 16px;
    }

    .error.visible { display: block; }

    @media (max-width: 600px) {
        nav { padding: 16px 20px; }
        .container { padding: 24px 16px; }
    }
</style>

<script>
    // IANA timezone IDs for each key
    const TZ_META = {
        EST: { zone: 'America/New_York',    label: 'Eastern Time' },
        GMT: { zone: 'Etc/GMT',             label: 'Greenwich Mean Time' },
        IST: { zone: 'Asia/Kolkata',        label: 'India Standard Time' },
        PST: { zone: 'America/Los_Angeles', label: 'Pacific Time' },
        BST: { zone: 'Europe/London',       label: 'British Time' },
    };

    const TZ_KEYS = Object.keys(TZ_META);
    const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    // Convert "YYYY-MM-DDTHH:MM" interpreted in `zone` → Unix seconds
    function localToEpochSec(datetimeStr, zone) {
        const [datePart, timePart] = datetimeStr.split('T');
        const [year, month, day] = datePart.split('-').map(Number);
        const [hour, minute] = timePart.split(':').map(Number);

        // Start with the naive UTC interpretation, then iteratively correct
        let guessMs = Date.UTC(year, month - 1, day, hour, minute);

        for (let i = 0; i < 3; i++) {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: zone,
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', hour12: false,
            }).formatToParts(new Date(guessMs));

            const p = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
            const h = p.hour === '24' ? 0 : Number(p.hour);
            const displayedMs = Date.UTC(Number(p.year), Number(p.month) - 1, Number(p.day), h, Number(p.minute));
            const targetMs   = Date.UTC(year, month - 1, day, hour, minute);
            const diff = targetMs - displayedMs;
            guessMs += diff;
            if (diff === 0) break;
        }

        return Math.floor(guessMs / 1000);
    }

    // Convert Unix seconds → all timezone representations
    function epochToAllZones(epochSec) {
        const d = new Date(epochSec * 1000);
        const result = {};

        for (const [key, { zone }] of Object.entries(TZ_META)) {
            const parts = new Intl.DateTimeFormat('en-US', {
                timeZone: zone,
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', hour12: false,
                weekday: 'long',
            }).formatToParts(d);

            const p = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
            const h = p.hour === '24' ? '00' : p.hour;

            const abbr = new Intl.DateTimeFormat('en-US', {
                timeZone: zone, timeZoneName: 'short',
            }).formatToParts(d).find(x => x.type === 'timeZoneName')?.value ?? key;

            result[key] = {
                datetime: `${p.year}-${p.month}-${p.day} ${h}:${p.minute}`,
                abbr,
                full: `${p.weekday}, ${p.day} ${MONTHS[Number(p.month) - 1]} ${p.year} at ${h}:${p.minute} ${abbr}`,
            };
        }

        return result;
    }

    function buildGrid(gridId, result, sourceKey) {
        const grid = document.getElementById(gridId);
        grid.innerHTML = '';
        TZ_KEYS.forEach(tz => {
            const r = result[tz];
            const [date, time] = r.datetime.split(' ');
            const [y, m, d] = date.split('-').map(Number);
            const dateLabel = `${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][new Date(y, m-1, d).getDay()]}, ${MONTHS[m-1]} ${d}`;
            const isSource = tz === sourceKey;
            grid.innerHTML += `
                <div class="tz-card${isSource ? ' source' : ''}">
                    <div class="tz-label">${TZ_META[tz].label}</div>
                    <div class="tz-time">${time}</div>
                    <div class="tz-date">${dateLabel}</div>
                    <span class="tz-abbr">${r.abbr}</span>
                </div>`;
        });
    }

    function switchTab(mode) {
        document.querySelectorAll('.tab').forEach((t, i) => {
            t.classList.toggle('active', (i === 0) === (mode === 'datetime'));
        });
        document.getElementById('panel-datetime').classList.toggle('active', mode === 'datetime');
        document.getElementById('panel-epoch').classList.toggle('active', mode === 'epoch');
    }

    function convertDatetime() {
        const errorEl  = document.getElementById('error-dt');
        const resultsEl = document.getElementById('results-dt');
        errorEl.classList.remove('visible');

        const time = (document.getElementById('datetime-input')).value;
        const sourceTz = (document.getElementById('source-tz')).value;

        if (!time) {
            errorEl.textContent = 'Please select a date and time.';
            errorEl.classList.add('visible');
            return;
        }

        try {
            const epochSec = localToEpochSec(time, TZ_META[sourceTz].zone);
            const result = epochToAllZones(epochSec);
            buildGrid('grid-dt', result, sourceTz);
            document.getElementById('epoch-from-dt').textContent = String(epochSec);
            resultsEl.classList.add('visible');
        } catch (e) {
            errorEl.textContent = 'Conversion failed. Please check your input.';
            errorEl.classList.add('visible');
        }
    }

    function convertEpoch() {
        const errorEl  = document.getElementById('error-ep');
        const resultsEl = document.getElementById('results-ep');
        errorEl.classList.remove('visible');

        const epochVal = (document.getElementById('epoch-input')).value.trim();
        if (!epochVal) {
            errorEl.textContent = 'Please enter an epoch timestamp.';
            errorEl.classList.add('visible');
            return;
        }

        try {
            const result = epochToAllZones(Number(epochVal));
            buildGrid('grid-ep', result, null);
            resultsEl.classList.add('visible');
        } catch (e) {
            errorEl.textContent = 'Conversion failed. Please check your input.';
            errorEl.classList.add('visible');
        }
    }

    async function copyEpoch(id) {
        const val = document.getElementById(id).textContent;
        if (val === '—') return;
        await navigator.clipboard.writeText(val);
        const btn = event.target;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 1500);
    }

    // Pre-fill datetime with current local time
    const now = new Date();
    const pad = (n) => String(n).padStart(2, '0');
    (document.getElementById('datetime-input')).value =
        `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;

    document.addEventListener('keydown', e => {
        if (e.key !== 'Enter') return;
        const activePanel = document.querySelector('.panel.active');
        if (activePanel?.id === 'panel-datetime') convertDatetime();
        else convertEpoch();
    });

    // Expose to window for onclick handlers
    window.switchTab = switchTab;
    window.convertDatetime = convertDatetime;
    window.convertEpoch = convertEpoch;
    window.copyEpoch = copyEpoch;
</script>
