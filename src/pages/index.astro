---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abhilash HP — Software Engineer" description="Software engineer, builder, and creator.">
    <nav>
        <span class="nav-brand">iamabhilash.in</span>
        <div class="nav-links">
            <a href="/tools">Tools</a>
            <a href="https://github.com/abhilashhp" target="_blank" rel="noopener">GitHub</a>
            <a href="https://linkedin.com/in/abhilashhp" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </nav>

    <main>
        <section class="hero">
            <h1>Abhilash HP</h1>
            <!-- TODO: Update your title below -->
            <p class="title">Software Engineer</p>
            <!-- TODO: Write a 1–2 line tagline about yourself -->
            <p class="tagline">
                I build things for the web. Passionate about clean code, developer tooling, and solving real problems.
            </p>
            <div class="hero-actions">
                <!-- Make sure you add your resume as public/resume.pdf -->
                <a href="/resume.pdf" download class="btn btn-primary">↓ Download Resume</a>
                <a href="/tools" class="btn btn-secondary">View Tools →</a>
            </div>
        </section>

        <section class="section">
            <h2>About</h2>
            <div class="divider"></div>
            <!-- TODO: Replace with your actual bio -->
            <p class="body-text">
                Hi, I'm Abhilash — a software engineer based in [Your City]. I enjoy building tools that make developers' lives easier, working across the full stack, and shipping things that matter.
            </p>
            <p class="body-text">
                When I'm not writing code, you'll find me [your hobbies / interests].
            </p>
        </section>

        <section class="section">
            <h2>Experience</h2>
            <div class="divider"></div>
            <div class="experience-list">
                <!-- TODO: Replace with your actual experience. Copy this block for each role. -->
                <div class="experience-item">
                    <div class="experience-header">
                        <div>
                            <span class="role">Senior Software Engineer</span>
                            <span class="company"> · Company Name</span>
                        </div>
                        <span class="duration">2022 – Present</span>
                    </div>
                    <ul class="experience-bullets">
                        <li>Built and maintained X, resulting in Y improvement.</li>
                        <li>Led a team of N engineers to deliver Z feature on time.</li>
                    </ul>
                </div>

                <div class="experience-item">
                    <div class="experience-header">
                        <div>
                            <span class="role">Software Engineer</span>
                            <span class="company"> · Previous Company</span>
                        </div>
                        <span class="duration">2020 – 2022</span>
                    </div>
                    <ul class="experience-bullets">
                        <li>Describe your key contribution here.</li>
                        <li>Another bullet point about impact or technology used.</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>Skills</h2>
            <div class="divider"></div>
            <!-- TODO: Update with your actual skills -->
            <div class="skills">
                <span class="skill">Python</span>
                <span class="skill">JavaScript</span>
                <span class="skill">TypeScript</span>
                <span class="skill">React</span>
                <span class="skill">Node.js</span>
                <span class="skill">Docker</span>
                <span class="skill">PostgreSQL</span>
                <span class="skill">Git</span>
            </div>
        </section>
    </main>

    <footer>
        <p>© {new Date().getFullYear()} Abhilash HP · <a href="mailto:your@email.com">your@email.com</a></p>
    </footer>
</Layout>

<style>
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 40px;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(8px);
        z-index: 10;
    }

    .nav-brand {
        font-weight: 700;
        font-size: 1rem;
        color: var(--text);
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .nav-links {
        display: flex;
        gap: 24px;
        font-size: 0.9rem;
    }

    .nav-links a {
        color: var(--muted);
        transition: color 0.2s;
    }

    .nav-links a:hover {
        color: var(--text);
        text-decoration: none;
    }

    main {
        max-width: 720px;
        margin: 0 auto;
        padding: 60px 24px;
    }

    .hero {
        margin-bottom: 64px;
    }

    .hero h1 {
        font-size: 2.75rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
        margin-bottom: 8px;
    }

    .title {
        font-size: 1.1rem;
        color: var(--muted);
        margin-bottom: 16px;
        font-weight: 500;
    }

    .tagline {
        font-size: 1.05rem;
        color: var(--text);
        max-width: 560px;
        margin-bottom: 32px;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: opacity 0.2s, transform 0.1s;
        cursor: pointer;
    }

    .btn:hover {
        opacity: 0.85;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: #fff;
    }

    .btn-secondary {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }

    .section {
        margin-bottom: 56px;
    }

    .section h2 {
        font-size: 1.15rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin-bottom: 12px;
    }

    .divider {
        height: 1px;
        background: var(--border);
        margin-bottom: 24px;
    }

    .body-text {
        color: var(--text);
        line-height: 1.75;
        margin-bottom: 12px;
    }

    .experience-list {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .experience-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .role {
        font-weight: 600;
        font-size: 1rem;
        color: var(--text);
    }

    .company {
        color: var(--muted);
        font-size: 0.95rem;
    }

    .duration {
        font-size: 0.85rem;
        color: var(--muted);
        white-space: nowrap;
    }

    .experience-bullets {
        padding-left: 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .experience-bullets li {
        color: var(--text);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .skills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .skill {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    footer {
        text-align: center;
        padding: 32px 24px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.875rem;
    }

    footer a {
        color: var(--muted);
    }

    footer a:hover {
        color: var(--text);
    }

    @media (max-width: 600px) {
        nav { padding: 16px 20px; }
        .hero h1 { font-size: 2rem; }
        main { padding: 40px 20px; }
        .experience-header { flex-direction: column; gap: 4px; }
    }
</style>
