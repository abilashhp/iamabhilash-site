        </div>
    </div>
</div>

<!-- ── KEY ACHIEVEMENTS ── -->
<div class="highlights">
    <div class="highlights-inner">
        <div class="hl-card">
            <span class="hl-icon">🛡️</span>
            <span class="hl-title">Built Scraper Score</span>
            <span class="hl-desc">Bot detection engine protecting Fortune 500 clients from evasive scrapers across 200M+ daily requests</span>
        </div>
        <div class="hl-divider"></div>
