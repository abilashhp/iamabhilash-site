---
// Naming Ceremony Invitation — September 21, 2026
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Naming Ceremony — September 21, 2026</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Cinzel:wght@400;500;600&family=Lato:wght@300;400&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --ivory:     #fdf6ec;
            --cream:     #f5e8d0;
            --gold:      #b8860b;
            --gold-lt:   #d4a843;
            --gold-pale: #f0d080;
            --rust:      #9e3d2a;
            --rose:      #c27a7a;
            --deep:      #3a1f0f;
            --mid:       #6b3c2a;
            --muted:     #9c7d6a;
        }

        body {
            font-family: 'Lato', sans-serif;
            background: var(--ivory);
            color: var(--deep);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── BACKGROUND PATTERN ─── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                radial-gradient(ellipse 80% 50% at 50% 0%, rgba(184,134,11,0.08) 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 50% 100%, rgba(158,61,42,0.06) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        /* ── BORDER FRAME ─────── */
        .frame {
            position: relative;
            z-index: 1;
            max-width: 760px;
            margin: 40px auto;
            padding: 4px;
            background: linear-gradient(135deg, var(--gold), var(--gold-pale), var(--gold), var(--rust), var(--gold));
            border-radius: 4px;
        }

        .card {
            background: var(--ivory);
            border-radius: 2px;
            overflow: hidden;
        }

        /* ── TOP ORNAMENT ─────── */
        .top-ornament {
            background: linear-gradient(135deg, var(--deep) 0%, var(--rust) 50%, var(--deep) 100%);
            padding: 20px 48px 18px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .top-ornament::before,
        .top-ornament::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            width: 120px;
            background: repeating-linear-gradient(
                90deg,
                transparent 0px,
                transparent 6px,
                rgba(212,168,67,0.15) 6px,
                rgba(212,168,67,0.15) 7px
            );
        }
        .top-ornament::before { left: 0; }
        .top-ornament::after  { right: 0; }

        .ceremony-tag {
            font-family: 'Cinzel', serif;
            font-size: 0.65rem;
            letter-spacing: 0.35em;
            color: var(--gold-pale);
            text-transform: uppercase;
            margin-bottom: 6px;
            opacity: 0.85;
        }

        .sanskrit {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gold-lt);
            line-height: 1;
            letter-spacing: 0.04em;
        }

        .divider-gold {
            width: 120px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-lt), transparent);
            margin: 12px auto;
        }

        .invite-line {
            font-family: 'Cinzel', serif;
            font-size: 0.7rem;
            letter-spacing: 0.28em;
            color: rgba(240,208,128,0.7);
            text-transform: uppercase;
        }

        /* ── MAIN BODY ────────── */
        .body {
            padding: 52px 64px 40px;
            text-align: center;
        }

        @media (max-width: 600px) {
            .body { padding: 36px 28px 32px; }
            .frame { margin: 16px; }
        }

        .from-line {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            color: var(--muted);
            letter-spacing: 0.06em;
            margin-bottom: 6px;
        }

        .parents {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 500;
            color: var(--deep);
            letter-spacing: -0.01em;
            line-height: 1.2;
            margin-bottom: 6px;
        }

        .joy-line {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.05rem;
            font-style: italic;
            color: var(--mid);
            margin-bottom: 48px;
        }

        /* ── SECRET LOTUS ─────── */
        .lotus-wrap {
            position: relative;
            width: 200px;
            height: 200px;
            margin: 0 auto 36px;
        }

        .lotus-wrap svg {
            width: 200px;
            height: 200px;
            filter: drop-shadow(0 4px 24px rgba(184,134,11,0.25));
            animation: float 4s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-7px); }
        }

        .secret-label {
            position: absolute;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.75rem;
            font-style: italic;
            color: var(--muted);
            white-space: nowrap;
            letter-spacing: 0.08em;
        }

        /* ── HEADLINE ─────────── */
        .headline {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1.8rem, 5vw, 2.6rem);
            font-weight: 600;
            line-height: 1.25;
            color: var(--deep);
            margin-bottom: 10px;
        }

        .headline em {
            font-style: italic;
            color: var(--rust);
        }

        .reveal-promise {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.05rem;
            font-style: italic;
            color: var(--muted);
            max-width: 460px;
            margin: 0 auto 44px;
            line-height: 1.7;
        }

        /* ── ORNAMENT DIVIDER ─── */
        .ornament {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 0 auto 40px;
            max-width: 320px;
        }

        .ornament-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-lt));
        }

        .ornament-line:last-child {
            background: linear-gradient(90deg, var(--gold-lt), transparent);
        }

        .ornament-diamond {
            width: 8px; height: 8px;
            background: var(--gold);
            transform: rotate(45deg);
            flex-shrink: 0;
        }

        .ornament-diamond-sm {
            width: 5px; height: 5px;
            background: var(--gold-lt);
            transform: rotate(45deg);
            flex-shrink: 0;
        }

        /* ── DATE/TIME BLOCK ──── */
        .event-block {
            display: grid;
            grid-template-columns: 1fr 1px 1fr;
            gap: 0;
            margin-bottom: 40px;
            border: 1px solid rgba(184,134,11,0.2);
            border-radius: 2px;
            overflow: hidden;
        }

        .event-col {
            padding: 28px 24px;
            background: rgba(184,134,11,0.03);
        }

        .event-sep {
            background: rgba(184,134,11,0.2);
        }

        .event-label {
            font-family: 'Cinzel', serif;
            font-size: 0.58rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 10px;
        }

        .event-main {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--deep);
            line-height: 1;
            margin-bottom: 4px;
        }

        .event-sub {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.95rem;
            color: var(--muted);
            font-style: italic;
        }

        /* ── SCHEDULE ─────────── */
        .schedule {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            margin-bottom: 40px;
            border: 1px solid rgba(184,134,11,0.15);
            border-radius: 2px;
            overflow: hidden;
        }

        .sched-item {
            flex: 1;
            padding: 20px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(240,208,128,0.05);
        }

        .sched-sep {
            width: 1px;
            align-self: stretch;
            background: rgba(184,134,11,0.15);
            flex-shrink: 0;
        }

        .sched-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .sched-time {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--deep);
            line-height: 1;
        }

        .sched-desc {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.85rem;
            color: var(--muted);
            font-style: italic;
        }

        /* ── VENUE ────────────── */
        .venue-block {
            background: rgba(184,134,11,0.04);
            border: 1px solid rgba(184,134,11,0.18);
            border-radius: 2px;
            padding: 28px 32px;
            margin-bottom: 28px;
        }

        .venue-label {
            font-family: 'Cinzel', serif;
            font-size: 0.58rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 12px;
        }

        .venue-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--deep);
            margin-bottom: 6px;
            line-height: 1.2;
        }

        .venue-addr {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.95rem;
            color: var(--mid);
            font-style: italic;
            line-height: 1.6;
            margin-bottom: 18px;
        }

        .directions-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: transparent;
            border: 1.5px solid var(--gold);
            color: var(--gold);
            font-family: 'Cinzel', serif;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            transition: background 0.2s, color 0.2s;
        }

        .directions-btn:hover {
            background: var(--gold);
            color: var(--ivory);
            text-decoration: none;
        }

        /* ── BOTTOM ORNAMENT ──── */
        .bottom-ornament {
            background: linear-gradient(135deg, var(--deep) 0%, var(--rust) 50%, var(--deep) 100%);
            padding: 22px 48px;
            text-align: center;
        }

        .rsvp-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.9rem;
            color: rgba(240,208,128,0.65);
            font-style: italic;
            letter-spacing: 0.05em;
        }

        .rsvp-text a {
            color: var(--gold-pale);
            text-decoration: none;
            border-bottom: 1px solid rgba(240,208,128,0.35);
        }

        .rsvp-text a:hover {
            border-color: var(--gold-pale);
        }

        .blessings {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-style: italic;
            color: var(--gold-lt);
            margin-top: 6px;
        }

        /* ── MOBILE TWEAKS ────── */
        @media (max-width: 520px) {
            .event-block {
                grid-template-columns: 1fr;
            }
            .event-sep { display: none; }
            .event-col { border-bottom: 1px solid rgba(184,134,11,0.2); }
            .event-col:last-child { border-bottom: none; }

            .schedule { flex-direction: column; }
            .sched-sep { width: 100%; height: 1px; }
            .sched-item { width: 100%; }

            .top-ornament { padding: 18px 24px; }
            .bottom-ornament { padding: 18px 24px; }
        }
    </style>
</head>
<body>

<div class="frame">
<div class="card">

    <!-- TOP ORNAMENT -->
    <div class="top-ornament">
        <p class="ceremony-tag">Namakarana &middot; Naming Ceremony</p>
        <p class="sanskrit">ನಾಮಕರಣ</p>
        <div class="divider-gold"></div>
        <p class="invite-line">You are warmly invited</p>
    </div>

    <!-- MAIN BODY -->
    <div class="body">

        <p class="from-line">With overflowing joy,</p>
        <p class="parents">Abhilash &amp; Prathibha</p>
        <p class="joy-line">joyfully invite you to the naming ceremony of their daughter</p>

        <!-- SECRET LOTUS -->
        <div class="lotus-wrap">
            <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- outer glow ring -->
                <circle cx="100" cy="100" r="90" stroke="rgba(184,134,11,0.12)" stroke-width="1"/>
                <circle cx="100" cy="100" r="80" stroke="rgba(184,134,11,0.18)" stroke-width="0.5" stroke-dasharray="4 4"/>

                <!-- petals — rear layer -->
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.55)" transform="rotate(0,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(45,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(90,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(135,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(180,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(225,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(270,100,100)"/>
                <ellipse cx="100" cy="58" rx="14" ry="30" fill="rgba(194,122,122,0.45)" transform="rotate(315,100,100)"/>

                <!-- petals — front layer -->
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(22,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(67,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(112,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(157,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(202,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(247,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(292,100,100)"/>
                <ellipse cx="100" cy="62" rx="11" ry="26" fill="rgba(212,140,140,0.75)" transform="rotate(337,100,100)"/>

                <!-- center disc -->
                <circle cx="100" cy="100" r="28" fill="#fdf6ec" stroke="rgba(184,134,11,0.4)" stroke-width="1.5"/>
                <circle cx="100" cy="100" r="22" fill="rgba(240,208,128,0.18)" stroke="rgba(184,134,11,0.25)" stroke-width="1"/>

                <!-- question mark -->
                <text x="100" y="112" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="36" font-style="italic" fill="#b8860b" opacity="0.9">?</text>
            </svg>
            <span class="secret-label">her name blooms on the day</span>
        </div>

        <!-- HEADLINE -->
        <h1 class="headline">A name <em>yet to be gifted</em><br/>to the world</h1>
        <p class="reveal-promise">
            Her name is a secret held close, waiting to be whispered<br/>
            to the universe for the very first time — on this auspicious day.
        </p>

        <!-- ORNAMENT -->
        <div class="ornament">
            <div class="ornament-line"></div>
            <div class="ornament-diamond-sm"></div>
            <div class="ornament-diamond"></div>
            <div class="ornament-diamond-sm"></div>
            <div class="ornament-line"></div>
        </div>

        <!-- DATE + DAY BLOCK -->
        <div class="event-block">
            <div class="event-col">
                <p class="event-label">Date</p>
                <p class="event-main">September 21</p>
                <p class="event-sub">Monday, 2026</p>
            </div>
            <div class="event-sep"></div>
            <div class="event-col">
                <p class="event-label">Ceremony begins</p>
                <p class="event-main">10:15 AM</p>
                <p class="event-sub">do join us early</p>
            </div>
        </div>

        <!-- SCHEDULE -->
        <div class="schedule">
            <div class="sched-item">
                <span class="sched-icon">🪔</span>
                <div style="text-align:left;">
                    <div class="sched-time">10:15 AM</div>
                    <div class="sched-desc">Naming Ceremony</div>
                </div>
            </div>
            <div class="sched-sep"></div>
            <div class="sched-item">
                <span class="sched-icon">🍱</span>
                <div style="text-align:left;">
                    <div class="sched-time">12:00 PM</div>
                    <div class="sched-desc">Lunch &amp; Celebration</div>
                </div>
            </div>
        </div>

        <!-- ORNAMENT -->
        <div class="ornament">
            <div class="ornament-line"></div>
            <div class="ornament-diamond-sm"></div>
            <div class="ornament-diamond"></div>
            <div class="ornament-diamond-sm"></div>
            <div class="ornament-line"></div>
        </div>

        <!-- VENUE -->
        <div class="venue-block">
            <p class="venue-label">Venue</p>
            <p class="venue-name">V One Hotel — Ambara Elite</p>
            <p class="venue-addr">
                Patidar Samaj, 40, Hesarghatta Road<br/>
                near 8th Mile Circle, Havanur Layout<br/>
                T. Dasarahalli, Bengaluru, Karnataka 560073
            </p>
            <a
                href="https://maps.google.com/maps?q=2GW4%2BPX+Bengaluru,+Karnataka"
                target="_blank"
                rel="noopener"
                class="directions-btn"
            >
                ↗ Get Directions
            </a>
        </div>

    </div><!-- /body -->

    <!-- BOTTOM ORNAMENT -->
    <div class="bottom-ornament">
        <div class="divider-gold" style="margin-bottom:14px;"></div>
        <p class="rsvp-text">
            Questions? Call or WhatsApp Abhilash at
            <a href="tel:+916361251166">+91 63612 51166</a>
        </p>
        <p class="blessings">Your presence and blessings mean the world to us.</p>
        <div class="divider-gold" style="margin-top:14px;"></div>
    </div>

</div><!-- /card -->
</div><!-- /frame -->

</body>
</html>
